generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  handle         String          @unique
  displayName    String?
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  identities     Identity[]
  sessions       Session[]
  enrollments    Enrollment[]
  computeProfiles ComputeProfile[]
  environmentReports EnvironmentReport[]
  repositories   Repository[]
  submissions    Submission[]
  experiments    Experiment[]
  journalEntries JournalEntry[]
  masteryEvidence MasteryEvidence[]
  masteryStates  MasteryState[]
  auditEvents    AuditEvent[]
  unitStates     LearnerUnitState[]
}

model Identity {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String   @db.Uuid
  provider       String
  providerUserId String
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Session {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @db.Uuid
  tokenHash  String   @unique
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model CourseVersion {
  id            String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courseId      String
  version       String
  contentSha256 String
  publishedAt   DateTime     @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @db.Timestamptz(6)
  units         UnitVersion[]
  enrollments   Enrollment[]
  submissions   Submission[]

  @@unique([courseId, version])
  @@unique([courseId, contentSha256])
}

model UnitVersion {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  courseVersionId String        @db.Uuid
  unitId          String
  version         String
  contentSha256   String
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)
  learnerStates   LearnerUnitState[]
  masteryStates   MasteryState[]

  @@unique([courseVersionId, unitId, version])
  @@index([unitId])
}

model Enrollment {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String        @db.Uuid
  courseVersionId String        @db.Uuid
  track           String
  currentUnitId   String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)

  @@unique([userId, courseVersionId])
}

model LearnerUnitState {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String      @db.Uuid
  unitVersionId String      @db.Uuid
  state         String
  updatedAt     DateTime    @updatedAt @db.Timestamptz(6)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitVersion   UnitVersion @relation(fields: [unitVersionId], references: [id], onDelete: Restrict)

  @@unique([userId, unitVersionId])
  @@index([userId, state])
}

model ComputeProfile {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String   @db.Uuid
  detectedGpu     String?
  vramGiB         Float?
  bf16Supported   Boolean  @default(false)
  cudaAvailable   Boolean  @default(false)
  selectedProfile String
  precision       String
  gradScaler      Boolean  @default(false)
  evidenceJson    Json
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model EnvironmentReport {
  id              String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String   @db.Uuid
  pythonVersion   String?
  pytorchVersion  String?
  operatingSystem String?
  cudaVersion     String?
  gpuModel        String?
  totalVramBytes  BigInt?
  bf16Supported   Boolean?
  selectedProfile String?
  fpllmVersion    String?
  repositoryCommit String?
  reportJson      Json
  capturedAt      DateTime @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  experimentRuns  ExperimentRun[]

  @@index([userId, capturedAt])
}

model GitHubInstallation {
  id                     String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  githubInstallationId   BigInt              @unique
  accountLogin           String
  accountType            String
  suspendedAt            DateTime?           @db.Timestamptz(6)
  createdAt              DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(6)
  repositories           Repository[]
  bindings               RepositoryBinding[]
}

model Repository {
  id                     String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                 String              @db.Uuid
  githubInstallationDbId String?             @db.Uuid
  provider               String              @default("github")
  owner                  String
  name                   String
  providerRepositoryId   BigInt?
  defaultBranch          String?
  createdAt              DateTime            @default(now()) @db.Timestamptz(6)
  user                   User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubInstallation     GitHubInstallation? @relation(fields: [githubInstallationDbId], references: [id], onDelete: SetNull)
  bindings               RepositoryBinding[]
  submissions            Submission[]

  @@unique([userId, provider, owner, name])
  @@index([githubInstallationDbId])
}

model RepositoryBinding {
  id                     String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  repositoryId           String             @db.Uuid
  githubInstallationDbId String             @db.Uuid
  boundAt                DateTime           @default(now()) @db.Timestamptz(6)
  repository             Repository         @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  githubInstallation     GitHubInstallation @relation(fields: [githubInstallationDbId], references: [id], onDelete: Restrict)

  @@unique([repositoryId, githubInstallationDbId])
}

model Submission {
  id              String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId          String        @db.Uuid
  repositoryId    String        @db.Uuid
  courseVersionId String        @db.Uuid
  labId           String
  labVersion      String
  branch          String
  commitSha       String        @db.Char(40)
  state           String
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  finalizedAt     DateTime?     @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  repository      Repository    @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Restrict)
  testRuns        TestRun[]
  experiments     Experiment[]
  artifacts       ExperimentArtifact[]

  @@index([userId, labId, createdAt])
  @@index([commitSha])
}

model TestRun {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  submissionId String       @db.Uuid
  state        String
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  startedAt    DateTime?    @db.Timestamptz(6)
  completedAt  DateTime?    @db.Timestamptz(6)
  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  results      TestResult[]
  jobs         Job[]

  @@index([submissionId, createdAt])
}

model TestResult {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  testRunId   String   @db.Uuid
  visibility  String
  groupId     String
  invariantId String?
  passed      Boolean
  summary     String
  evidenceJson Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  testRun     TestRun  @relation(fields: [testRunId], references: [id], onDelete: Restrict)

  @@index([testRunId, visibility])
  @@index([invariantId])
}

model Experiment {
  id             String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  displayId      String      @unique
  userId         String      @db.Uuid
  submissionId   String      @db.Uuid
  experimentType String
  state          String
  commitSha      String      @db.Char(40)
  hypothesis     String?
  prediction     String?
  lockedAt       DateTime?   @db.Timestamptz(6)
  conclusion     String?
  createdAt      DateTime    @default(now()) @db.Timestamptz(6)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  submission     Submission  @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  runs           ExperimentRun[]
  artifacts      ExperimentArtifact[]
  journalEntry   JournalEntry?

  @@index([userId, experimentType, createdAt])
  @@index([commitSha])
}

model ExperimentRun {
  id                    String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  experimentId          String                 @db.Uuid
  environmentReportId   String?                @db.Uuid
  status                String
  failureCode           String?
  startedAt             DateTime?              @db.Timestamptz(6)
  completedAt           DateTime?              @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  experiment            Experiment             @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  environmentReport     EnvironmentReport?     @relation(fields: [environmentReportId], references: [id], onDelete: SetNull)
  metrics               ExperimentMetric[]
  artifacts             ExperimentArtifact[]

  @@index([experimentId, createdAt])
}

model ExperimentMetric {
  id                String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  experimentRunId   String        @db.Uuid
  sequenceLength    Int
  status            String
  peakAllocatedBytes BigInt?
  peakReservedBytes BigInt?
  tokensPerSecond   Float?
  stepSeconds       Float?
  failureCode       String?
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  experimentRun     ExperimentRun @relation(fields: [experimentRunId], references: [id], onDelete: Restrict)

  @@unique([experimentRunId, sequenceLength])
}

model ExperimentArtifact {
  id             String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  experimentId   String         @db.Uuid
  experimentRunId String?       @db.Uuid
  submissionId   String?        @db.Uuid
  sha256         String         @db.Char(64)
  byteSize       BigInt
  mediaType      String
  artifactType   String
  storageKey     String?
  visibility     String         @default("private")
  metadataJson   Json
  createdAt      DateTime       @default(now()) @db.Timestamptz(6)
  experiment     Experiment     @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  experimentRun  ExperimentRun? @relation(fields: [experimentRunId], references: [id], onDelete: Restrict)
  submission     Submission?    @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([experimentId, createdAt])
  @@index([sha256])
}

model JournalEntry {
  id           String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String                @db.Uuid
  experimentId String?               @unique @db.Uuid
  kind         String
  visibility   String                @default("private")
  createdAt    DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(6)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  experiment   Experiment?           @relation(fields: [experimentId], references: [id], onDelete: Restrict)
  versions     JournalEntryVersion[]
}

model JournalEntryVersion {
  id             String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  journalEntryId String       @db.Uuid
  version        Int
  observation    String?
  interpretation String?
  uncertainty    String?
  nextExperiment String?
  conclusion     String?
  finalizedAt    DateTime?    @db.Timestamptz(6)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, version])
}

model MasteryRequirement {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  unitId       String
  unitVersion  String
  dimension    String
  evidenceType String
  required     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  @@unique([unitId, unitVersion, dimension])
}

model MasteryEvidence {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String   @db.Uuid
  unitId      String
  unitVersion String
  dimension   String
  evidenceType String
  evidenceRef String
  status      String
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, unitId, unitVersion, dimension, evidenceRef])
  @@index([userId, unitId, unitVersion])
}

model MasteryState {
  id            String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId        String      @db.Uuid
  unitVersionId String      @db.Uuid
  status        String
  computedAt    DateTime    @default(now()) @db.Timestamptz(6)
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitVersion   UnitVersion @relation(fields: [unitVersionId], references: [id], onDelete: Restrict)

  @@unique([userId, unitVersionId])
}

model Job {
  id            String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobType       String
  state         String
  payloadJson   Json
  testRunId     String?    @db.Uuid
  attemptCount  Int        @default(0)
  leaseOwner    String?
  leaseExpiresAt DateTime? @db.Timestamptz(6)
  nextAttemptAt DateTime?  @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @db.Timestamptz(6)
  startedAt     DateTime?  @db.Timestamptz(6)
  completedAt   DateTime?  @db.Timestamptz(6)
  testRun       TestRun?   @relation(fields: [testRunId], references: [id], onDelete: SetNull)
  events        JobEvent[]

  @@index([state, nextAttemptAt])
  @@index([leaseExpiresAt])
}

model JobEvent {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  jobId     String   @db.Uuid
  eventType String
  dataJson  Json?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model AuditEvent {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorUserId   String?  @db.Uuid
  eventType     String
  objectType    String?
  objectId      String?
  correlationId String?
  dataJson      Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  actor         User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([correlationId])
}

model IdempotencyRecord {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorKey     String
  routeKey     String
  idempotencyKey String
  responseCode Int
  responseJson Json
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime @db.Timestamptz(6)

  @@unique([actorKey, routeKey, idempotencyKey])
  @@index([expiresAt])
}
