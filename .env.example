# Local PostgreSQL 18
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fpllm?schema=public

# Course content root. Defaults can resolve the monorepo course/ directory in development.
COURSE_CONTENT_ROOT=./course

# Prototype actor; authentication provider remains an open architecture decision.
FPLLM_DEMO_HANDLE=demo

# GitHub App integration shared by web submission verification and the worker.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# v0.3 worker execution. Production images must be immutable digest references.
FPLLM_TEST_RUNTIME_IMAGE=registry.example/fpllm/test-runtime@sha256:
FPLLM_HIDDEN_EVALUATOR_IMAGE=registry.example/fpllm/hidden-evaluator@sha256:

# Public bundle may be exposed to learner code. Private bundle must only be
# mounted into the separate hidden-evaluator container.
FPLLM_PUBLIC_TEST_BUNDLE_ROOT=/srv/fpllm/public-test-bundles
FPLLM_PRIVATE_TEST_BUNDLE_ROOT=/srv/fpllm/private-test-bundles

# Optional worker controls.
FPLLM_WORKER_ID=
FPLLM_WORKER_LEASE_SECONDS=300
FPLLM_WORKER_POLL_MS=2000
FPLLM_DOCKER_BINARY=docker
FPLLM_WORKER_TEMP_ROOT=/srv/fpllm/work
FPLLM_WORKER_ONCE=0
