# Local PostgreSQL 18
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fpllm?schema=public

# Course content root. Defaults can resolve the monorepo course/ directory in development.
COURSE_CONTENT_ROOT=./course

# Prototype actor; authentication provider remains an open architecture decision.
FPLLM_DEMO_HANDLE=demo

# GitHub App integration (optional in v0.2)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
