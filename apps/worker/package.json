{
  "name": "@fpllm/worker",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fpllm/observability": "workspace:*",
    "@fpllm/test-sandbox": "workspace:*"
  },
  "scripts": {
    "start": "pnpm --dir ../../packages/db exec tsx ../../apps/worker/src/index.ts",
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --dir ../../packages/db exec tsx --test ../../apps/worker/src/runtime.test.ts",
    "lint": "tsc --noEmit -p tsconfig.json"
  }
}
